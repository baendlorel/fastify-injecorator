{
  "extends": "../../tsconfig.json",
  "references": [{ "path": "../core" }],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@nestify-js/core": ["../core/src/index.ts"],
      "@nestify-js/shared": ["../shared/src/index.ts"],
      "@core/*": ["../core/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
