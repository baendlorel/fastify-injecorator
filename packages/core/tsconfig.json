{
  "extends": "../../tsconfig.json",
  "references": [{ "path": "../shared" }],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@core/*": ["./src/*"],
      "@nestify/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "../shared/src/sym.ts", "../shared/src/status.ts"],
  "exclude": ["node_modules", "dist"]
}
