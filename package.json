{
  "name": "injecorator-monorepo",
  "version": "0.0.18",
  "description": "A NestJS like fastify plugin for dependency injection - Monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "check": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest",
    "testall": "clear && vitest",
    "stress": "clear && vitest '.stress.e2e-spec.ts'",
    "e2e": "clear && vitest '.e2e-spec.ts'",
    "spec": "clear && vitest '.spec.ts'",
    "clean": "pnpm -r clean",
    "dev": "tsx watch example/main.ts",
    "lines": "clear && find ./packages -type f \\( -name \"*.ts\" -o -name \"*.tsx\" -o -name \"*.js\" -o -name \"*.mjs\" -o -name \"*.cjs\" \\) | xargs wc -l"
  },
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baendlorel/fastify-injecorator"
  },
  "keywords": [
    "nestjs",
    "decorator",
    "fastify",
    "typescript",
    "javascript",
    "dependency-injection",
    "monorepo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@anatine/zod-mock": "^3.14.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "oxlint": "^1.72.0",
    "prettier": "^3.9.4",
    "rollup-plugin-func-macro": "^1.2.3",
    "tsdown": "^0.22.3",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
