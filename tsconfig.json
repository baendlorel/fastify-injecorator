{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@injecorator/shared": ["./packages/shared/src/index.ts"],
      "@shared/*": ["./packages/shared/src/*"],
      "@core/*": ["./packages/core/src/*"],
      "@schema/*": ["./packages/schema/src/*"],
      "@swagger/*": ["./packages/swagger/src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "*.config.ts",
    "packages/shared/**/*.ts",
    "packages/core/**/*.ts",
    "packages/schema/**/*.ts",
    "packages/swagger/**/*.ts",
    "example/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
