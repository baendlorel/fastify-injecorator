{
  "name": "@nestify-js/schema",
  "version": "0.0.18",
  "description": "Schema validation and utilities for nestify-js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "schema",
    "validation",
    "zod",
    "typescript"
  ],
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "fastify-type-provider-zod": "7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.1.0",
    "fastify": "^5.9.0",
    "rollup-plugin-func-macro": "^1.2.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}