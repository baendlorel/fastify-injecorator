{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["packages/core/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["packages/core/**/*.ts", "example/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
