{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@shared/*": ["./packages/_shared/*"],
      "@core/*": ["./packages/core/*"],
      "@schema/*": ["./packages/schema/*"],
      "@swagger/*": ["./packages/swagger/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "packages/_shared/**/*.ts",
    "packages/core/**/*.ts",
    "packages/schema/**/*.ts",
    "packages/swagger/**/*.ts",
    "example/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
