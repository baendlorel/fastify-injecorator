{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@core/*": ["./src/*"],
      "@shared/*": ["../_shared/src/*"]
    }
  },
  "include": ["**/*.ts", "../_shared/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
